# Local settings for this computer only. Copy this file to .env (which git ignores) and fill it in:
#
#   cp .env.example .env        (or: scripts/doctor.sh --fix)
#
# Lines are KEY=VALUE. Quotes around a value are optional; nothing here is run as a command.
# Only names starting with SOLOTON_ are read, and a variable already set in your shell wins.

# A folder on this computer that holds your music, one sub-folder per game, for example
#   /home/you/Music/games/Some Game/01 - Song.mp3
# scripts/gen1-emulator.sh copies its audio files to the emulator, and
# ./gradlew :apps:roadwork:desktop:run shows its song names and counts. Leave it empty to skip both.
SOLOTON_MUSIC_DIR=

# Where the music goes on the emulator. The default is the app's default music root.
# SOLOTON_MUSIC_DEVICE_DIR=/sdcard/Music/soloton
